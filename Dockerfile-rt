FROM ubuntu:22.04

# docker build -t 192.168.1.11:8085/tasks-rt:latest  -f Dockerfile-rt .
# docker push 192.168.1.11:8085/tasks-rt:latest

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG C.UTF-8
ENV TZ Asia/Shanghai

WORKDIR /opt/
COPY requirements.txt requirements.txt

RUN echo "Build runtime" \
    && apt-get update \
    && apt-get install -y tzdata curl python3 python-is-python3 python3-pip libpq-dev \
    && pip install -i http://mirrors.aliyun.com/pypi/simple/ --trusted-host mirrors.aliyun.com -r requirements.txt \
    && apt-get clean \
    && apt-get autoclean \
    && rm -rf /var/lib/apt/lists/*