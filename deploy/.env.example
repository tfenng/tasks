# Copy to deploy/.env before `docker compose up`.
# Generate a key with:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
TASK_CONTROL_SECRET_KEYS={"1":"REPLACE_WITH_32_BYTE_BASE64"}
TASK_CONTROL_SECRET_ACTIVE_VERSION=1
TASK_CONTROL_COOKIE_SECURE=false
TASK_CONTROL_WORKER_CONCURRENCY=4
TASK_CONTROL_RETENTION_DAYS=395
TASK_CONTROL_ATTEMPT_RETENTION_DAYS=90

# Optional overrides used by deploy/docker-compose.yml.
# POSTGRES_DB=task_control
# POSTGRES_USER=task_control
# POSTGRES_PASSWORD=task_control
# POSTGRES_PORT=5432
# TASK_CONTROL_API_PORT=8000
